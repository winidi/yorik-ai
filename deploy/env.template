# The all-in-one install's settings. The installers create .env from
# this with fresh random values; do the same by hand if you copy it.
# Keep .env private: it holds the database passwords.

# Which Yorik release to run: "stable" follows released versions.
YORIK_VERSION=stable
TZ=Europe/Berlin
YORIK_PORT=8000
YORIK_PHOTOS_PORT=2283
# Folder on this computer for encrypted backups (a USB or cloud drive
# folder works too). The installers set it.
YORIK_BACKUP_DIR=./backups

# Generated secrets (long random strings; never reuse between installs)
YORIK_DB_PASSWORD=
YORIK_JWT_SECRET=
IMMICH_DB_PASSWORD=
PAPERLESS_DB_PASSWORD=
PAPERLESS_SECRET_KEY=
PAPERLESS_ADMIN_PASSWORD=
PAPERLESS_YORIK_TOKEN=
YORIK_WA_BRIDGE_TOKEN=

# AI model (Ollama in the stack by default)
YORIK_MODEL=robit/qwen3.5-9b-r7-research-vision:q4km
# YORIK_LLM_URL=http://ollama:11434/v1

# Tailscale: leave empty and sign in via Yorik → Settings → System →
# Phones, or paste a reusable auth key from the Tailscale admin console.
TS_AUTHKEY=
YORIK_TS_HOSTNAME=yorik
# serve-funnel.json once Funnel is allowed (see tailscale/README.md)
YORIK_TS_SERVE=serve.json
