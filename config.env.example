# HomeOS / Yorik — machine configuration.
# All machine-specific settings live here. Swap models or endpoints
# by editing this file; no Python edits needed.
#
# Loaded automatically by backend/__init__.py via python-dotenv.
# Also sourced by start.sh and install.sh so the shell knows them too.

# ─── LLM ─────────────────────────────────────────────────────────────
# Yorik is a CLIENT — point it at any OpenAI-compatible local LLM
# you already run. No backend is bundled; no recommendation is forced.
# Pick whichever fits your hardware + workflow:
#
#   llama-swap       :8080   multi-model, dynamic switching, recommended
#                            if you want to run multiple models
#   Ollama           :11434  easiest install, single-model focus,
#                            good if you only need chat
#   LM Studio        :1234   GUI, good for desktop tinkering
#   llama.cpp server :8081   single model, lowest deps
#   vLLM             :8000   GPU-heavy production-grade
#   anything else    any     as long as it speaks OpenAI Chat Completions
#
# The defaults below assume llama-swap on :8080 (the maintainer's setup).
# CHANGE THESE TWO LINES to match what you actually run, then re-run
# start.sh — it'll detect the new endpoint and use it.
#
# You can also configure live via the UI: Settings → LLM has a "Detect"
# button that scans common local ports. Changes take effect on the next
# chat turn without a restart.

# Chat LLM endpoint. Leave HOMEOS_MODEL empty to let the endpoint pick
# its own default (works for llama-swap and single-model backends);
# set it to a specific name like "qwen3-9b" if your endpoint routes by name.
HOMEOS_LLM_BASE_URL=http://127.0.0.1:8080/v1
HOMEOS_MODEL=

# Embedder — Yorik bundles a local sentence-transformers embedder
# (paraphrase-multilingual-MiniLM-L12-v2, ~120 MB, 384-dim, German + English
# + 48 more languages) so semantic search works out of the box without
# any external embeddings endpoint. Backend selection:
#
#   HOMEOS_EMBED_BACKEND=auto      (default) external first if set, local fallback
#   HOMEOS_EMBED_BACKEND=local     use only the bundled embedder
#   HOMEOS_EMBED_BACKEND=external  use only HOMEOS_EMBED_BASE_URL, no fallback
#   HOMEOS_EMBED_BACKEND=off       disable embeddings; hybrid search degrades to FTS only
#
# If you have a fast GPU embedder running already (llama-swap with an
# embedding model loaded, Ollama with nomic-embed-text pulled, etc.),
# set HOMEOS_EMBED_BASE_URL below to use it as the primary. Note: the
# external embedder's output dim MUST match the local model's (384 by
# default). Override HOMEOS_EMBED_DIM and re-index if you use a 768-dim
# external embedder like nomic-embed-text.
HOMEOS_EMBED_BACKEND=auto
HOMEOS_EMBED_BASE_URL=
HOMEOS_EMBED_MODEL=nomic-embed-text

# Override the bundled local model. The default is multilingual and
# small enough for any modern laptop; swap to a larger model if you
# have GPU and want better quality. Changing this drops + recreates
# the vec0 tables on next startup (chunks survive — they re-embed
# automatically on the reconciler's next pass).
# HOMEOS_EMBED_LOCAL_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Override the embedding dimension. Only set this if you're running an
# external embedder with a non-default dim (e.g. 768 for nomic-embed-text).
# Must match whatever your embedder actually outputs, or insertions fail.
# HOMEOS_EMBED_DIM=384

# Cloud providers also work via the same OpenAI-compatible surface —
# set HOMEOS_LLM_BASE_URL to https://api.openai.com/v1 (etc.) and
# add HOMEOS_LLM_API_KEY. Note: cloud breaks Yorik's local-only
# privacy guarantee — only use it if you accept that trade.
# HOMEOS_LLM_API_KEY=

# Context window. Most local backends pick a reasonable default; set
# this only if your backend needs an explicit hint. Ignored by Ollama
# (which uses the model's trained context length automatically).
# HOMEOS_LLM_NUM_CTX=32768

# ─── Voice (STT + TTS + speaker ID) ──────────────────────────────────
# Optional: HuggingFace Hub token. The first run downloads voice models
# (Whisper, Supertonic, SpeechBrain) from huggingface.co. Anonymous
# downloads are rate-limited and may fail on busy evenings. Get a free
# token at https://huggingface.co/settings/tokens (read-only is enough)
# and uncomment the line below.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HOMEOS_WHISPER_MODEL=tiny     # tiny=fast (~300ms), base=more accurate (~800ms)
# STT engine. Default 'whisper' runs Whisper locally — no API key,
# no network, audio never leaves the device. Switch to 'groq' or
# 'openai-compatible' via Settings → LLM → Speech-to-text to use a
# cloud provider (faster + more accurate German, but audio is sent
# to the provider). Whisper is always the silent fallback if the
# cloud endpoint is unreachable.
# HOMEOS_STT_BACKEND=whisper
# HOMEOS_STT_URL=https://api.groq.com/openai/v1/audio/transcriptions
# HOMEOS_STT_MODEL_NAME=whisper-large-v3-turbo
# HOMEOS_STT_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Supertonic-3 voice styles (M1..M5 male, F1..F5 female). The same single
# multilingual model is used for every language — only the voice timbre changes.
HOMEOS_TTS_VOICE=M1
# Per-language overrides — set HOMEOS_TTS_VOICE_<LANG_UPPER> for any
# supported language. Lookup is dynamic so a new language just works.
HOMEOS_TTS_VOICE_DE=F1
# HOMEOS_TTS_VOICE_FR=M3
# HOMEOS_TTS_VOICE_PL=F2
# HOMEOS_TTS_VOICE_ES=M1
# HOMEOS_TTS_VOICE_IT=F4
HOMEOS_VOICES_DIR=data/voices
HOMEOS_DEFAULT_LANGUAGE=en
# Cosine similarity cutoff for SpeechBrain ECAPA identification.
# 0.65 is the recommended starting point for short utterances (1-3s).
# Tune up if you see false-positive ID's, down if real users aren't matching.
HOMEOS_VOICE_MATCH_THRESHOLD=0.65
HOMEOS_SPEAKER_MODEL_DIR=data/speaker_model
# Minimum enrollment seconds enforced server-side. UI should still recommend 15s.
HOMEOS_VOICE_ENROLL_MIN_SECONDS=2
# Hard ceiling for a single voice ASK recording (user can stop earlier by
# clicking the mic again). Prevents runaway records if someone forgets.
HOMEOS_VOICE_MAX_SECONDS=60

# ─── Storage ─────────────────────────────────────────────────────────
# SQLite paths (used only when YORIK_DB_BACKEND is unset or "sqlite").
HOMEOS_DB_PATH=data/family.db
# Documents + vector index live in a SEPARATE SQLite file by design.
# Heavy reindex jobs never lock family.db. The vector index can be
# wiped + rebuilt without touching personal data.
HOMEOS_DOCS_DB_PATH=data/documents.db
HOMEOS_DOCS_DIR=data/documents

# ─── Postgres backend (Phase D) ─────────────────────────────────────
# Set YORIK_DB_BACKEND=postgres to flip Yorik from SQLite to the
# bundled self-hosted Supabase Postgres. Prerequisite: the Supabase
# Docker stack at infra/supabase/docker/ is running. The data has
# been migrated via scripts/migrate_sqlite_data.py.
#
# When unset (or "sqlite"), Yorik runs on the SQLite paths above —
# no Postgres involvement. Both backends pass identical Phase C
# smoke + isolation tests; the shim in backend/db_shim.py translates
# SQL on the way through.
#
# YORIK_DB_PASSWORD is the POSTGRES_PASSWORD from
# infra/supabase/docker/.env (chmod 600, never commit).
#
# YORIK_SKIP_BIND_PROBE=1 silences the "port 8000 already in use"
# self-check; set only when you're sure no other Yorik holds it.
#
#YORIK_DB_BACKEND=postgres
#YORIK_DB_NAME=yorik
#YORIK_DB_HOST=127.0.0.1
#YORIK_DB_PORT=5435
#YORIK_DB_USER=postgres
#YORIK_DB_PASSWORD=<paste POSTGRES_PASSWORD from infra/supabase/docker/.env>
#YORIK_SKIP_BIND_PROBE=1

# ─── RAG / chunking ──────────────────────────────────────────────────
# Embedder settings live in the LLM section above. These are just the
# chunking knobs — defaults work for prose; tune for code-heavy or
# list-heavy corpora.
HOMEOS_CHUNK_SIZE=500
HOMEOS_CHUNK_OVERLAP=50

# ─── Locale ──────────────────────────────────────────────────────────
# Timezone used by Immich / Paperless for log timestamps + UI
# display. start.sh auto-detects from /etc/timezone on first run and
# writes the value here; UTC is the fallback. Per-user reply language
# is set in onboarding (Settings → Profile) — this is just the server's
# wall-clock timezone, not the chat language.
# YORIK_TZ=Europe/Berlin
#
# Paperless OCR languages — comma-separated Tesseract language packs
# (deu, eng, fra, spa, ita, pol, …). Adding a language requires the
# Paperless container to download its language pack on first OCR run.
# Default 'eng' is safest; change to "eng+deu" etc. if your documents
# are multilingual.
# PAPERLESS_OCR_LANGUAGE=eng
#
# Paperless CSRF trusted origins — needed if you reach Yorik (or
# Paperless directly) over a hostname other than localhost. Django
# checks the Origin/Referer of POST/PUT/PATCH/DELETE against this list.
# Defaults already cover localhost:8000 + 127.0.0.1:8000 (set in
# docker-compose.yml); add your tailnet / VPN / LAN hostname here if
# you access Paperless from another device. Comma-separated, no spaces,
# scheme + host + port required. Example for a tailscale-served install:
#   PAPERLESS_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://yorik-home.tailABCD.ts.net:8445
# PAPERLESS_CSRF_TRUSTED_ORIGINS=

# ─── Network ports ───────────────────────────────────────────────────
HOMEOS_PORT=8000
HOMEOS_N8N_PORT=5678

# ─── n8n integration (BYO only) ───────────────────────────────────────
# n8n is NOT bundled. It ships under the Sustainable Use License (not
# OSI-approved open source), so Yorik can't include it without dragging
# SUL distribution terms into the AGPL-3 codebase. The path-prefix
# proxy at /n8n/, connector_templates/*.json, and backend/n8n_proxy.py
# stay in the codebase as integration hooks for users who run their
# own n8n separately.
#
# To use: install n8n yourself (Docker, npm, or n8n cloud) and set
# the URL below. If something is already on :5678 when start.sh runs,
# it auto-points HOMEOS_N8N_BASE_URL at it.
# Generate an API key via the n8n UI: Settings → API → New.
# Without this, OAuth-heavy connectors (email-gmail, sms-twilio, etc.)
# that route through n8n simply won't have a send path.
HOMEOS_N8N_API_KEY=
HOMEOS_N8N_BASE_URL=http://127.0.0.1:5678

# ─── Bring-your-own external services ────────────────────────────────
# If you already have Immich / Paperless / WhatsApp bridge
# running on this machine, start.sh detects them by port probe and
# SKIPS bundling its own. The vars below get auto-populated then so
# Yorik talks to your existing instance:
#
#   PAPERLESS_INTERNAL_URL=http://127.0.0.1:8010   # set automatically
#   YORIK_WA_BRIDGE_URL=http://127.0.0.1:3015      # set automatically
#   HOMEOS_N8N_BASE_URL (above) gets repointed automatically
#
# Immich is stored differently: open Settings → Connectors → Immich
# and paste your URL + admin API key (start.sh prints a reminder).
#
# To force-skip bundling something even when the port is free, just
# set its URL above manually — start.sh leaves user-set values alone.

# ─── Opt-out: don't bundle a service at all ──────────────────────────
# Set any of these to 0 to make start.sh skip the bundled container
# entirely (no image pulled, no resources consumed). The Yorik UI for
# the disabled service stays installed — flip back to 1 later and
# re-run start.sh to bring it up. Default 1 (bundle).
#
#   YORIK_ENABLE_WHATSAPP=0   # privacy / "I don't use WhatsApp"
#   YORIK_ENABLE_PAPERLESS=0  # I already manage docs elsewhere
#   YORIK_ENABLE_IMMICH=0     # this box doesn't have disk for a photo lib
YORIK_ENABLE_WHATSAPP=1
YORIK_ENABLE_PAPERLESS=1
YORIK_ENABLE_IMMICH=1

# ─── Credential store (Wave 4) ───────────────────────────────────────
# Where the Fernet master key lives. Auto-generated with mode 0600 on
# first connector-credential write. Back this up if you back up data/.
HOMEOS_CREDENTIAL_KEY_PATH=data/.credential_key


# ─── Phase D — Postgres backend ──────────────────────────────────────
# Yorik can run against SQLite (default, single-file) or Postgres (the
# bundled Supabase stack at infra/supabase/docker/). Postgres unlocks
# the Phase F-lite multi-tenant story; SQLite is fine for single-user
# self-host. Switching backends requires re-running install.sh and
# a fresh start.
#
#   YORIK_DB_BACKEND=postgres (default) bundled Supabase Postgres cluster.
#                             Required for multi-tenant, restorable backups,
#                             cross-process auth, and several other features.
#   YORIK_DB_BACKEND=sqlite   legacy single-file DB at data/family.db. Use only
#                             on no-docker boxes / dev. Some features disabled.
YORIK_DB_BACKEND=postgres

# Postgres connection — only consulted when YORIK_DB_BACKEND=postgres.
# Leave YORIK_DB_PASSWORD empty: the backend reads it from
# infra/supabase/docker/.env (POSTGRES_PASSWORD) automatically. Set
# it here only if your Postgres is OUTSIDE the bundled stack.
YORIK_DB_HOST=127.0.0.1
YORIK_DB_PORT=5435
YORIK_DB_USER=postgres
YORIK_DB_NAME=postgres
YORIK_DB_PASSWORD=


# ─── Phase F-lite — multi-tenant ─────────────────────────────────────
# Only used when YORIK_DB_BACKEND=postgres. Per-tenant Yorik instances
# share the host's Immich + Paperless; each tenant gets its own
# isolated yorik_tenant_<name> database. Operator UI lives at
# Settings → Households on the host instance.
#
# YORIK_TENANT_BASE_DOMAIN  Used by create-tenant.sh to build per-tenant
#                            Caddy snippets (e.g. mom.<base> → :8001).
#                            Default 'yorik.local' for local-only use;
#                            set to your real domain before exposing
#                            tenants on the public web.
YORIK_TENANT_BASE_DOMAIN=yorik.local

# YORIK_TRUSTED_ORIGINS  Comma-separated origins past the CSRF check.
#                        Add your host's public URL(s) when fronting
#                        Yorik with Caddy.
#                        Example: https://yorik.example.com
YORIK_TRUSTED_ORIGINS=
