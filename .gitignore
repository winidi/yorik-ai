# Python
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# Local data — user-owned + downloaded model files, never committed.
# Everything under data/ is ignored EXCEPT this .gitkeep so git keeps the
# directory itself around for fresh clones.
# (data/documents/ — uploaded files; data/documents.db — vector index;
#  data/family.db — operational data; data/voices/ — Piper voices;
#  data/speaker_model/ — SpeechBrain; data/.credential_key — Fernet key)
data/*
!data/.gitkeep

# Community apps installed via the Marketplace land here at runtime.
# The catalog ships them from examples/<app>/ (which IS committed);
# `/apps/` is the per-user install dir and stays out of the repo.
# Anchored to repo root so frontend-react/src/apps/ keeps working.
/apps/

# Logs / pid files
*.log
/tmp/
homeos-*.pid

# Defensive: legacy SQL-runner artefact pattern (16-char-hex dirs at
# repo root). Vanna was removed but the guard stays — costs nothing,
# catches a class of accidental commits. Min 8 hex chars so plain
# words like `backend/` and `frontend/` aren't accidentally ignored.
/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*/

# Editor / OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db
*~
*.swp

# Local config — contains secrets (n8n API key, etc).
# Tracked alternative: config.env.example
config.env
config.local.env
.env
.env.*
node_modules_tiptap_build/
node_modules_tailwind_build/
needs-testing.md

# Vite sourcemaps. Useful for local debugging, not for distribution —
# they bake in third-party source which can carry author contact
# metadata (we caught a transitive dep's email leaking via this path).
# The build still emits them; we just don't commit them.
frontend-react/dist/assets/*.map

# Maintainer-only docs. Live in the working tree but don't ship in
# the public repo — internal handoff notes, pre-release checklists,
# the eval / chat-audit trail, and the project-context file that AI
# coding assistants read (useful locally, contains internal "how to
# work on Yorik" guidance that doesn't belong in the public narrative).
HANDOFF.md
SMOKE-CHECKLIST.md
evals/
CLAUDE.md

# Phase D — local Supabase docker setup (cloned upstream, not vendored)
infra/supabase/

# Per-tenant Caddy snippets generated by scripts/create-tenant.sh.
# Each operator's tenants are their own — nothing to commit.
infra/caddy/tenants/*.caddy

# Locally-installed LLM weights (downloaded by install.sh). Multi-GB
# binaries — never check these into the repo.
models/
