{
  "id": "evening-recap",
  "name": "Evening recap",
  "description": "Today retrospective + tomorrow plan + photos from today",
  "author": "yorik-core",
  "version": "1.0",
  "tags": ["daily", "personal"],
  "sections": [
    {
      "id":       "today-recap",
      "title":    "Today",
      "icon":     "☀️",
      "skill":    "check_calendar",
      "args":     {
        "start_iso": "{today_start}",
        "end_iso":   "{today_end}"
      },
      "render":   "events_list",
      "priority": "high"
    },
    {
      "id":       "tomorrow-plan",
      "title":    "Tomorrow",
      "icon":     "→",
      "skill":    "check_calendar",
      "args":     {
        "start_iso":          "{tomorrow_start}",
        "end_iso":            "{tomorrow_end}",
        "include_free_slots": true
      },
      "render":   "events_list",
      "priority": "high"
    },
    {
      "id":       "photos-today",
      "title":    "Photos from today",
      "icon":     "📷",
      "skill":    "find_photo",
      "args":     {
        "op":         "taken_on",
        "start_iso":  "{today_start}",
        "end_iso":    "{today_end}",
        "take_count": 12
      },
      "render":   "raw_json"
    },
    {
      "id":       "email-summary",
      "title":    "Email today",
      "icon":     "📧",
      "skill":    "email_briefing",
      "args":     { "hours": 12 },
      "render":   "markdown"
    },
    {
      "id":       "whatsapp-summary",
      "title":    "WhatsApp today",
      "icon":     "💬",
      "skill":    "whatsapp_briefing",
      "args":     { "hours": 12 },
      "render":   "markdown",
      "condition": "result.stats.chats_with_new_msgs > 0"
    }
  ],
  "synthesize": {
    "enabled": false
  }
}
